# Supabase project (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Institutional email allowlist, comma separated domains.
# EMPTY = every domain is allowed (development default).
# Example: university.edu,community-college.edu
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=

# Test-harness passwords (scripts/e2e.mjs, scripts/simulate.mjs).
# Copy your own throwaway fixture password here; .env.local is gitignored
# and never committed. Empty = the scripts refuse to run.
E2E_PASSWORD=
SIM_PARTNER_PASSWORD=
